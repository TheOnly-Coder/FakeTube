rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true if the caller owns the channel with the given ID.
    // Handles both normal channels (doc ID == auth UID) and migrated
    // channels (doc ID differs, but doc.authUid == auth UID).
    function ownsChannel(channelId) {
      return request.auth != null
        && (request.auth.uid == channelId
          || get(/databases/$(database)/documents/users/$(channelId)).data.authUid == request.auth.uid);
    }

    // ---- Users ----
    match /users/{userId} {
      // Anyone signed in can read user profiles
      allow read: if request.auth != null;

      // Create: only the user themselves (on signup)
      allow create: if request.auth != null
        && request.auth.uid == userId;

      // Update: two separate branches
      // 1. Any authenticated user can update ONLY subscriberCount
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount'])
        && (request.resource.data.subscriberCount == resource.data.subscriberCount + 1
          || request.resource.data.subscriberCount == resource.data.subscriberCount - 1);

      // 2. Only the channel owner can update other fields
      allow update: if ownsChannel(userId)
        && request.resource.data.subscriberCount == resource.data.subscriberCount; // can't change subscriberCount here
    }

    // ---- Videos ----
    match /videos/{videoId} {
      // Anyone can read videos (including unauthenticated)
      allow read: if true;

      // Only the channel owner can create/update/delete
      allow create: if request.auth != null
        && ownsChannel(request.resource.data.uploaderId);
      allow update, delete: if ownsChannel(resource.data.uploaderId);
    }

    // ---- Comments ----
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ---- Posts ----
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && ownsChannel(request.resource.data.channelId);
      allow update, delete: if ownsChannel(resource.data.channelId);
    }

    // ---- Post Comments ----
    match /postComments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // ---- Post Stars ----
    match /postStars/{starId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ---- Subscribers ----
    match /subscribers/{subId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
